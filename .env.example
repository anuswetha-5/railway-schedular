# Indian Railways ABPS Enterprise Environment Configuration
# Copy this file to .env and configure values before starting the services

# API Authentication Key for REST endpoints (Use a strong random hex token in production)
RAILWAY_API_KEY=IR-PROD-SECURE-KEY-REPLACE-IN-PRODUCTION-2026

# In-Memory Sliding Window Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60

# Origin Whitelist for CORS Defense-in-Depth
ALLOWED_ORIGIN=http://localhost:8501

# Database File Path
DB_PATH=database/railway_planning.db

# Deployment Environment (development / staging / production)
ENVIRONMENT=production
